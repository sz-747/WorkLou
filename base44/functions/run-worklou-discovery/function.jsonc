{
  "name": "runWorkLouDiscovery",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "daily_worklou_discovery",
      "description": "Searches for a small batch of new WorkLou service candidates once each day.",
